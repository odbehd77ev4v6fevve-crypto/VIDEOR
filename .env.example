# VIDORA Platform Environment Variables

# Runtime environment (development / production)
NODE_ENV=development

# Server port (Dev server must run on 3000 in AI Studio)
PORT=3000

# Application hosting URL
APP_URL="http://localhost:3000"

# MongoDB connection URI. Local development falls back to the default local database if unset.
# Production must use a MongoDB Atlas SRV URL when MONGODB_URI is supplied explicitly.
MONGODB_URI="mongodb://127.0.0.1:27017/vidora_dev"

# Required only by the integration suite. Use a dedicated database whose name contains "test";
# never use the production database here.
TEST_MONGODB_URI="mongodb://127.0.0.1:27017/vidora_test"
TEST_ADMIN_EMAIL="admin@vidora.local"
TEST_ADMIN_PASSWORD="VidoraLocalPassword123!"
# Authentication JWT secret key. Local development uses a safe default if left blank.
JWT_SECRET="vidora-local-development-secret-key-123456"

# Google / YouTube Data API v3 Key
# Optional: Used for full YouTube video statistics, durations, tags, and category info.
# When not set, VIDORA safely uses YouTube's official oEmbed protocol for video details.
YOUTUBE_API_KEY=""

# Optional one-time/bootstrap seed controls. Leave disabled in normal deployments.
VIDORA_SEED="false"
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME="Vidora Admin"
























